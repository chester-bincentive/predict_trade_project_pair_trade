# Binance Predict market-data endpoints are signed. Use a Binance API key/secret
# with the permissions required by the Wallet Prediction API.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional Discord incoming webhook for live shadow PnL summaries.
# Create one in Discord: Server Settings > Integrations > Webhooks, then copy its URL.
# Leave blank to disable notifications. Keep the URL private and do not commit your .env file.
PAIR_DISCORD_WEBHOOK_URL=
# Send one summary on startup, then repeat at this interval (minimum 60 seconds).
PAIR_DISCORD_PNL_INTERVAL_SECONDS=900

# Strategy settings (all optional; defaults are in pairtrading/config.py).
# PAIR_POLL_SECONDS controls retry wait after feed errors; live samples follow WebSocket updates.
PAIR_POLL_SECONDS=1.0
PAIR_MATCH_TOLERANCE_SECONDS=2.0
PAIR_MAX_QUOTE_AGE_SECONDS=3.0
PAIR_Z_ENTRY=2.5
PAIR_MIN_HISTORY_MARKETS=50
PAIR_HISTORY_WINDOW_MARKETS=200
# RV10 entry gate: same-bucket q90 from all 100 completed markets in the rolling window.
PAIR_MIN_RV_HISTORY_MARKETS=100
PAIR_RV_HISTORY_WINDOW_MARKETS=100
PAIR_BUCKET_SECONDS=60
PAIR_HOLD_SECONDS=20
PAIR_MIN_SHARES=5
PAIR_TAKER_FEE_COEFFICIENT=0.07
# SHADOW ONLY: fixed 330ms total from simulated submit to order arrival; no jitter.
# First IOC uses the newest in-memory book received by arrival; it does not wait for a new update.
PAIR_POLY_ORDER_NETWORK_MS=330
PAIR_POLY_ORDER_API_MS=0
PAIR_BINANCE_ORDER_NETWORK_MS=330
PAIR_BINANCE_ORDER_API_MS=0
PAIR_ORDER_LATENCY_JITTER_MS=0
# Optional database override. By default, the DB stays under this project folder.
# PAIR_DB_PATH=data/pair_trading.sqlite3
